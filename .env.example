# Copy this file to .env and fill in the client's details.
# Leave a value empty to hide the matching link or turn the newsletter form off.

# Shown as the "Contact" link in the footer.
VITE_CONTACT_EMAIL=

# Full profile URL, e.g. https://www.instagram.com/<handle>
VITE_INSTAGRAM_URL=

# Endpoint that accepts a JSON POST of { "email": "..." } and returns a 2xx status on success.
VITE_NEWSLETTER_ENDPOINT=
